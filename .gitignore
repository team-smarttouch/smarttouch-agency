# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/

# Next.js build output & caches
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
next-env.d.ts

# Laravel storage & cache
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*.log
!backend/storage/logs/.gitignore
backend/storage/*.key
backend/public/build
backend/public/hot
backend/public/storage

# Environment sensitive files
.env
.env.backup
.env.production
.env.local
.env.*.local
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.backup
backend/.env.production

# Keep example env files
!.env.example
!frontend/.env.example
!backend/.env.example

# IDE & OS files
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/
