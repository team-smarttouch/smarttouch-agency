APP_NAME="Smart Touch"
APP_ENV=staging
APP_KEY=base64:Wjvnc4xn493FV97RPu4Z0MxteKWMvzNa50Uwxz5D2AY=
APP_DEBUG=false
APP_URL=https://api-staging.smarttouch.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database Connection (Configure with your cPanel MySQL details)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smtouch_laravel
# (On cPanel with username prefix, typically: cpaneluser_smtouch_laravel)
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=your_secure_password_here

# Frontend Staging Domain & CORS
FRONTEND_URL=https://staging.smarttouch.me
SANCTUM_STATEFUL_DOMAINS=staging.smarttouch.me,localhost:3000
SESSION_DOMAIN=.smarttouch.me

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Mail settings (Configure cPanel webmail / SMTP if required)
MAIL_MAILER=smtp
MAIL_HOST=mail.smarttouch.me
MAIL_PORT=465
MAIL_USERNAME=info@smarttouch.me
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@smarttouch.me"
MAIL_FROM_NAME="Smart Touch Advertising Agency"
